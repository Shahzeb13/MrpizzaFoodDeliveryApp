# Copy to `.env` and fill in your own values. `.env` is gitignored — never
# commit it.

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-key

# Mapbox public access token (starts with `pk.`).
# Used by the delivery-location map AND by Geocoding v6, which fills in the
# address when the pin is dropped. Never put a secret (`sk.`) token here: a
# mobile binary is not a secret store and the SDK refuses one anyway.
# Read at runtime by flutter_dotenv; alternatively pass it at build time with
# `--dart-define=MAPBOX_ACCESS_TOKEN=pk...`.
MAPBOX_ACCESS_TOKEN=pk.your_public_token_here

# Watch the free allowance: roughly 50,000 map loads a month, plus the geocoding
# calls the delivery map makes each time the pin settles. Address lookups used to
# run on OpenStreetMap, which was free but needed a monitored contact address in
# its User-Agent and answered 403 when that contact was a placeholder. They now
# run on the same Mapbox token as the map, so there is one key and one bill.
# Free also means no SLA, so treat a map that fails to load as a bug to fix,
# not an outage to expect.