<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied while the process is starting. The splash is warm ivory
         with the Mr. Pizza logo centred; the colour matches
         AppColors.background in Dart so the transition to Flutter is seamless. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Theme applied once the Flutter engine is ready. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
